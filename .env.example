# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram ID администраторов бота через запятую (например, староста группы)
ADMIN_IDS=123456789,987654321

# Путь к файлу базы данных SQLite (по умолчанию: homeworker.db)
DB_PATH=homeworker.db

# Настройки встроенного веб-сервера Telegram Mini App (TG App)
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Публичный URL приложения (для локальной работы: http://localhost:8080, для Telegram: HTTPS ссылка туннеля)
WEB_APP_URL=http://localhost:8080
